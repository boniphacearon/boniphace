# BONIPHACE Configuration
PORT=3000
JWT_SECRET=change-this-to-a-random-secret-string-min-32-chars
NODE_ENV=production

# Optional: External AI provider (if you want to use OpenAI/Claude instead of Puter.js)
# Leave blank to use Puter.js (free, no key needed)
AI_PROVIDER=puter
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# File upload limits
MAX_FILE_SIZE_MB=25
UPLOAD_DIR=./uploads